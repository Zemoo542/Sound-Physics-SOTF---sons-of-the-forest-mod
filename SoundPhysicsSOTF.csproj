<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SoundPhysicsSOTF</AssemblyName>
    <RootNamespace>SoundPhysicsSOTF</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Authors>Zemo</Authors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GameDir Condition="'$(GameDir)' == ''">$(SOTF_GAME_DIR)</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RedLoader">
      <HintPath>$(GameDir)\_Redloader\net6\RedLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SonsSdk">
      <HintPath>$(GameDir)\_Redloader\net6\SonsSdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\_Redloader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\_Redloader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\_Redloader\Game\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMOD.Unity">
      <HintPath>$(GameDir)\_Redloader\Game\FMOD.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.FMOD">
      <HintPath>$(GameDir)\_Redloader\Game\Sons.FMOD.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons">
      <HintPath>$(GameDir)\_Redloader\Game\Sons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.Construction.Utils">
      <HintPath>$(GameDir)\_Redloader\Game\Sons.Construction.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.Areas">
      <HintPath>$(GameDir)\_Redloader\Game\Sons.Areas.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Endnight">
      <HintPath>$(GameDir)\_Redloader\Game\Endnight.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="bolt">
      <HintPath>$(GameDir)\_Redloader\Game\bolt.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.TerrainModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.TerrainPhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\_Redloader\Game\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SoundPhysicsSOTF\manifest.json</TargetPath>
    </None>
  </ItemGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set SOTF_GAME_DIR or pass -p:GameDir to the Sons of the Forest install directory." />
    <Error Condition="!Exists('$(GameDir)\_Redloader\Game\Sons.dll')" Text="GameDir must point to a Sons of the Forest install containing _Redloader/Game/Sons.dll." />
  </Target>
</Project>
